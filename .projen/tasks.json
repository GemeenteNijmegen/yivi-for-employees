{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(npx -c \"node --print process.env.PATH\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bump": {
      "name": "bump",
      "description": "Bumps version based on latest git tag and generates a changelog entry",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^13"
      },
      "steps": [
        {
          "builtin": "release/resolve-latest-tag",
          "outputEnv": "LATEST_TAG"
        },
        {
          "spawn": "bump:releasable-commits",
          "outputEnv": "RELEASABLE_COMMITS",
          "condition": "git rev-parse --verify --quiet \"refs/tags/$LATEST_TAG\""
        },
        {
          "builtin": "release/suggest-version-bump",
          "outputEnv": "SUGGESTED_BUMP"
        },
        {
          "builtin": "release/apply-version-bump"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "bump:releasable-commits": {
      "name": "bump:releasable-commits",
      "description": "Print the releasable commits since the latest release",
      "steps": [
        {
          "exec": "git log --oneline $LATEST_TAG..HEAD"
        }
      ]
    },
    "bundle": {
      "name": "bundle",
      "description": "Prepare assets",
      "steps": [
        {
          "spawn": "bundle:app/disclose/disclose.lambda"
        },
        {
          "spawn": "bundle:app/issue/issue.lambda"
        },
        {
          "spawn": "bundle:app/post-login/postlogin.lambda"
        },
        {
          "spawn": "bundle:app/voetbalpool/voetbalpool.lambda"
        }
      ]
    },
    "bundle:app/disclose/disclose.lambda": {
      "name": "bundle:app/disclose/disclose.lambda",
      "description": "Create a JavaScript bundle from src/app/disclose/disclose.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/app/disclose/disclose.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/app/disclose/disclose.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--external:@aws-sdk/*",
            "--loader:.mustache=text"
          ]
        }
      ]
    },
    "bundle:app/disclose/disclose.lambda:watch": {
      "name": "bundle:app/disclose/disclose.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/app/disclose/disclose.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/app/disclose/disclose.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/app/disclose/disclose.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--external:@aws-sdk/*",
            "--loader:.mustache=text",
            "--watch"
          ]
        }
      ]
    },
    "bundle:app/issue/issue.lambda": {
      "name": "bundle:app/issue/issue.lambda",
      "description": "Create a JavaScript bundle from src/app/issue/issue.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/app/issue/issue.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/app/issue/issue.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--external:@aws-sdk/*",
            "--loader:.mustache=text"
          ]
        }
      ]
    },
    "bundle:app/issue/issue.lambda:watch": {
      "name": "bundle:app/issue/issue.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/app/issue/issue.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/app/issue/issue.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/app/issue/issue.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--external:@aws-sdk/*",
            "--loader:.mustache=text",
            "--watch"
          ]
        }
      ]
    },
    "bundle:app/post-login/postlogin.lambda": {
      "name": "bundle:app/post-login/postlogin.lambda",
      "description": "Create a JavaScript bundle from src/app/post-login/postlogin.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/app/post-login/postlogin.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/app/post-login/postlogin.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--external:@aws-sdk/*",
            "--loader:.mustache=text"
          ]
        }
      ]
    },
    "bundle:app/post-login/postlogin.lambda:watch": {
      "name": "bundle:app/post-login/postlogin.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/app/post-login/postlogin.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/app/post-login/postlogin.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/app/post-login/postlogin.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--external:@aws-sdk/*",
            "--loader:.mustache=text",
            "--watch"
          ]
        }
      ]
    },
    "bundle:app/voetbalpool/voetbalpool.lambda": {
      "name": "bundle:app/voetbalpool/voetbalpool.lambda",
      "description": "Create a JavaScript bundle from src/app/voetbalpool/voetbalpool.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/app/voetbalpool/voetbalpool.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/app/voetbalpool/voetbalpool.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--external:@aws-sdk/*",
            "--loader:.mustache=text"
          ]
        }
      ]
    },
    "bundle:app/voetbalpool/voetbalpool.lambda:watch": {
      "name": "bundle:app/voetbalpool/voetbalpool.lambda:watch",
      "description": "Continuously update the JavaScript bundle from src/app/voetbalpool/voetbalpool.lambda.ts",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/app/voetbalpool/voetbalpool.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/app/voetbalpool/voetbalpool.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--external:@aws-sdk/*",
            "--loader:.mustache=text",
            "--watch"
          ]
        }
      ]
    },
    "cfn-lint": {
      "name": "cfn-lint",
      "description": "Lint synthesized CloudFormation templates",
      "steps": [
        {
          "exec": "cfn-lint cdk.out/**/*.template.json -i W3005 W2001"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "execArgs": [
            "git",
            "checkout",
            "-b",
            "scratch"
          ],
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compile": {
      "name": "compile",
      "description": "Only compile"
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "execArgs": [
            "node",
            ".projenrc.js"
          ]
        }
      ]
    },
    "deploy": {
      "name": "deploy",
      "description": "Deploys your CDK app to the AWS cloud",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "deploy"
          ],
          "receiveArgs": true
        }
      ]
    },
    "destroy": {
      "name": "destroy",
      "description": "Destroys your cdk app in the AWS cloud",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "destroy"
          ],
          "receiveArgs": true
        }
      ]
    },
    "diff": {
      "name": "diff",
      "description": "Diffs the currently deployed app against your code",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "diff"
          ]
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "eslint": {
      "name": "eslint",
      "description": "Runs eslint against the codebase",
      "env": {
        "ESLINT_USE_FLAT_CONFIG": "false",
        "NODE_NO_WARNINGS": "1"
      },
      "steps": [
        {
          "execArgs": [
            "eslint",
            "--ext",
            ".ts,.tsx",
            "--fix",
            "--no-error-on-unmatched-pattern",
            "$@",
            "src",
            "src/app/login/tests",
            "src/app/auth/tests",
            "src/app/home/tests",
            "src/app/uitkeringen/tests",
            "src/app/logout/tests",
            "/test",
            "/build-tools",
            "src/shared/tests",
            ".projenrc.js"
          ],
          "receiveArgs": true
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "npm install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "npm ci"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "execArgs": [
            "mkdir",
            "-p",
            "dist/js"
          ]
        },
        {
          "execArgs": [
            "npm",
            "pack",
            "--pack-destination",
            "dist/js"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation",
      "steps": [
        {
          "spawn": "synth:silent"
        }
      ]
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "release:production": {
      "name": "release:production",
      "description": "Prepare a release from \"production\" branch",
      "env": {
        "RELEASE": "true",
        "MAJOR": "1"
      },
      "steps": [
        {
          "execArgs": [
            "rm",
            "-fr",
            "dist"
          ]
        },
        {
          "spawn": "bump"
        },
        {
          "spawn": "build"
        },
        {
          "spawn": "unbump"
        },
        {
          "exec": "git diff --ignore-space-at-eol --exit-code"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "synth": {
      "name": "synth",
      "description": "Synthesizes your cdk app into cdk.out",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "synth"
          ]
        }
      ]
    },
    "synth:silent": {
      "name": "synth:silent",
      "description": "Synthesizes your cdk app into cdk.out and suppresses the template in stdout (part of \"yarn build\")",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "synth",
            "-q"
          ]
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "execArgs": [
            "jest",
            "--passWithNoTests",
            "--updateSnapshot"
          ],
          "receiveArgs": true
        },
        {
          "spawn": "eslint"
        }
      ]
    },
    "test:watch": {
      "name": "test:watch",
      "description": "Run jest in watch mode",
      "steps": [
        {
          "execArgs": [
            "jest",
            "--watch"
          ]
        }
      ]
    },
    "unbump": {
      "name": "unbump",
      "description": "Restores version to 0.0.0",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^13"
      },
      "steps": [
        {
          "builtin": "release/reset-version"
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "upgrade dependencies",
      "env": {
        "CI": "0"
      },
      "steps": [
        {
          "execArgs": [
            "npx",
            "npm-check-updates@20",
            "--upgrade",
            "--target=minor",
            "--peer",
            "--no-deprecated",
            "--dep=dev,prod,peer,optional",
            "--filter=@aws-sdk/types,@axe-core/playwright,@glen/jest-raw-loader,@playwright/test,@types/aws-lambda,@types/jest,@types/node,aws-sdk-client-mock,axios-mock-adapter,copyfiles,esbuild,eslint-import-resolver-typescript,eslint-plugin-import,jest,projen,ts-jest,ts-node,typescript,@aws-cdk/aws-apigatewayv2-alpha,@aws-cdk/aws-apigatewayv2-integrations-alpha,@aws-lambda-powertools/logger,@aws-sdk/client-dynamodb,@aws-sdk/client-secrets-manager,@aws-solutions-constructs/aws-lambda-dynamodb,@gemeentenijmegen/apiclient,@gemeentenijmegen/apigateway-http,@gemeentenijmegen/aws-constructs,@gemeentenijmegen/cross-region-parameters,@gemeentenijmegen/projen-project-type,@gemeentenijmegen/session,@gemeentenijmegen/utils,@gemeentenijmegen/webapp,@types/mustache,axios,cdk-remote-stack,cookie,dotenv,jose,mustache,object-mapper,openid-client,xml2js"
          ]
        },
        {
          "exec": "npm install"
        },
        {
          "execArgs": [
            "npm",
            "update",
            "@aws-sdk/types",
            "@axe-core/playwright",
            "@glen/jest-raw-loader",
            "@playwright/test",
            "@stylistic/eslint-plugin",
            "@types/aws-lambda",
            "@types/jest",
            "@types/node",
            "@typescript-eslint/eslint-plugin",
            "@typescript-eslint/parser",
            "aws-cdk",
            "aws-sdk-client-mock",
            "axios-mock-adapter",
            "commit-and-tag-version",
            "copyfiles",
            "esbuild",
            "eslint-import-resolver-typescript",
            "eslint-plugin-import",
            "eslint",
            "jest",
            "jest-junit",
            "projen",
            "ts-jest",
            "ts-node",
            "typescript",
            "@aws-cdk/aws-apigatewayv2-alpha",
            "@aws-cdk/aws-apigatewayv2-integrations-alpha",
            "@aws-lambda-powertools/logger",
            "@aws-sdk/client-dynamodb",
            "@aws-sdk/client-secrets-manager",
            "@aws-solutions-constructs/aws-lambda-dynamodb",
            "@gemeentenijmegen/apiclient",
            "@gemeentenijmegen/apigateway-http",
            "@gemeentenijmegen/aws-constructs",
            "@gemeentenijmegen/cross-region-parameters",
            "@gemeentenijmegen/projen-project-type",
            "@gemeentenijmegen/session",
            "@gemeentenijmegen/utils",
            "@gemeentenijmegen/webapp",
            "@types/mustache",
            "aws-cdk-lib",
            "axios",
            "cdk-remote-stack",
            "constructs",
            "cookie",
            "dotenv",
            "jose",
            "mustache",
            "object-mapper",
            "openid-client",
            "xml2js"
          ]
        },
        {
          "exec": "npx projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watches changes in your source code and rebuilds and deploys to the current account",
      "steps": [
        {
          "execArgs": [
            "cdk",
            "deploy",
            "--hotswap"
          ]
        },
        {
          "execArgs": [
            "cdk",
            "watch"
          ]
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"npx projen\"."
}
